# Gemini (https://aistudio.google.com/apikey): every model the app uses, and
# the embeddings of the reference corpus. The only key the app needs.
GOOGLE_API_KEY=

# One chain per job: provider:model, first choice first, separated by commas.
# Generation: Reading exercises (rue_task) and Writing tasks (writing_task).
CAE_GENERATION_MODEL=google:gemini-3.1-flash-lite
# Marking: Reading (rue_evaluator) and Writing (writing_evaluator).
CAE_MARKING_MODEL=google:gemini-3.6-flash,google:gemini-3.7-flash,google:gemini-3.8-flash,google:gemini-3.1-flash-lite
# Coaching: the coach report (coach) and the coach chat (coach_chat).
CAE_COACH_MODEL=google:gemini-3.5-flash-lite

# Evals only, and PAID: the judge of the coach and chat suites (on by default;
# --no-judge skips it). The app never uses it.
OPENAI_API_KEY=
